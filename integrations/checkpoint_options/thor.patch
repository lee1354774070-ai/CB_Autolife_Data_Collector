+        calls.append((task, gripper_phase))
+        return build_demo_session(task)
+    factory._wyli_gripper_phases = ('pick', 'place', 'continuous')
+    engine = GrootRemoteEngine(demo_contract(), factory, mode='test')
+    for fields in ({'expected_checkpoint': 'old'}, {'gripper_phase': 'bad'}):
+        with pytest.raises(ProtocolError):
+            engine.start({'task': 'custom', **payload(1), **fields})
+    assert calls == []
+    engine.start({'task': 'custom', 'gripper_phase': 'pick', 'expected_checkpoint': 'new', **payload(1)})
