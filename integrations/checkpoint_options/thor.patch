+    def prepare_reload(self, payload):
+        with self.lock:
+            if self.session is not None or time.monotonic() < self.reload_deadline:
+                raise ProtocolError("Inference session or model switch is active")
+            self.reload_lease = secrets.token_hex(16)
+            self.reload_deadline = time.monotonic() + 60
+            return {"lease": self.reload_lease}
+
+    def cancel_reload(self, payload):
+        with self.lock:
+            if not self.reload_lease or payload.get("lease") != self.reload_lease:
+                raise ProtocolError("Invalid model switch lease")
+            self.reload_deadline = 0.0
+            self.reload_lease = ""
+            return {"cancelled": True}
 
