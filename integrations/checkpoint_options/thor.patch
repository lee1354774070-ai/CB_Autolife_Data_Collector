+def test_reload_lease_rejects_sessions_and_unknown_cancel():
+    engine = GrootRemoteEngine(demo_contract(), build_demo_session, mode="test")
+    lease = engine.prepare_reload({})
+    assert not engine.health()['ready']
+    with pytest.raises(ProtocolError, match="switch"):
+        engine.start({'task': 'task', **payload(1)})
+    with pytest.raises(ProtocolError):
+        engine.prepare_reload({})
+    with pytest.raises(ProtocolError):
+        engine.cancel_reload({'lease': 'bad'})
+    engine.cancel_reload(lease)
+    assert engine.health()['ready']
+    engine.start({'task': 'task', **payload(1)})
+    with pytest.raises(ProtocolError):
+        engine.prepare_reload({})
+
+
